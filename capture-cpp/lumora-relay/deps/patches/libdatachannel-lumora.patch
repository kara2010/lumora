+// leb128-Laengenfeld schreiben (av1-rtp-spec §4.4: Laenge jedes OBU-Elements ausser ggf. dem letzten)
+static void writeLeb128(binary &out, size_t v) {
+	do {
+		uint8_t b = uint8_t(v & 0x7F);
+		v >>= 7;
+		if (v)
+			b |= 0x80;
+		out.push_back(byte(b));
+	} while (v);
+}
+static size_t leb128Size(size_t v) {
+	size_t n = 1;
+	while (v >= 0x80) { v >>= 7; ++n; }
+	return n;
+}
