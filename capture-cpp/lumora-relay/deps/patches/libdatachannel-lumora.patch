+// LUMORA-PATCH 2 (Schwarzbild mit NVENC ab Treiber 617.42, AMD unberuehrt): Der Original-
+// Weg packetisierte jedes OBU einer Temporal Unit als EIGENE Paketkette (nur der Sequence
+// Header wurde dem naechsten OBU vorangestellt). Solange der Encoder ein einziges OBU_FRAME
+// je Bild lieferte, war das unsichtbar. Der neue NVIDIA-Treiber emittiert stattdessen
+// OBU_FRAME_HEADER + OBU_TILE_GROUP getrennt. Dann entstanden je Bild ZWEI Ketten:
+// [SeqHdr+FrameHeader] (Z=0,Y=0) und [TileGroup] (Z=0 ... Y=0). libwebrtc (Chrome, Edge,
+// WebView2, Firefox) leitet Bildanfang/-ende aber aus genau diesen Z-/Y-Bits ab
+// (is_first/is_last_packet_in_frame) - es sah ein "Keyframe" ohne Tile-Daten und ein
+// Delta-Bild ohne Frame-Header, verwarf beides und forderte per PLI endlos neue Keyframes.
+// Fix wie der libwebrtc-Packetizer selbst: ALLE OBUs der TU in EINE Paketkette aggregieren
+// (W-Feld / Laengenfelder), Paketgrenzen liegen immer in einem OBU-Fragment (Z/Y gesetzt),
+// N-Bit nur auf dem ersten Paket einer TU, die mit dem Sequence Header beginnt.
+std::vector<binary> AV1RtpPacketizer::packetizeTemporalUnit(const std::vector<binary> &obus) {
+	std::vector<binary> packets;
+	if (obus.empty())
+		return packets;
+	const size_t maxP = std::max<size_t>(mMaxFragmentSize, 32);
+	const bool startsWithSeqHdr =
+	    ((obus.front().at(0) & obuFrameTypeMask) >> obuFrameTypeBitshift) == obuFrameTypeSequenceHeader;
+
+	struct Elem { size_t obu, off, len; };
+	size_t i = 0, off = 0;
+	while (i < obus.size()) {
+		std::vector<Elem> elems;
+		size_t used = payloadHeaderSize;
+		const bool zFlag = (off > 0);
+		while (i < obus.size()) {
+			const size_t rest = obus[i].size() - off;
+			const size_t lenField = leb128Size(rest);
+			const size_t space = maxP - used;
+			if (space < lenField + 1)
+				break;
+			const bool lastObu = (i + 1 == obus.size());
+			if (lenField + rest <= space) {
+				// Rest des OBUs passt ganz. Endet es (fast) genau an der Paketgrenze und es folgen
+				// weitere OBUs, EIN Byte zurueckhalten: so bleibt die Kette ueber Z/Y verbunden,
+				// statt dass der Empfaenger an der OBU-Grenze ein neues Bild annimmt.
+				if (!lastObu && space - (lenField + rest) < 3) {
+					if (rest <= 1)
+						break;
+					elems.push_back({i, off, rest - 1});
+					off += rest - 1;
+					break;
+				}
+				elems.push_back({i, off, rest});
+				used += lenField + rest;
+				++i; off = 0;
+				if (lastObu)
+					break;
+			} else {
+				const size_t take = space - lenField;   // leb128(take) <= leb128(rest)
+				if (take == 0)
+					break;
+				elems.push_back({i, off, take});
+				off += take;
+				break;
+			}
+		}
+		if (elems.empty())
+			return packets;   // kann bei maxP >= 32 nicht eintreten - Endlosschleife ausschliessen
+
+		const Elem &last = elems.back();
+		const bool yFlag = (last.off + last.len < obus[last.obu].size());
+		const bool nFlag = startsWithSeqHdr && packets.empty();
+		const size_t w = elems.size() <= 3 ? elems.size() : 0;
+
+		binary pkt;
+		pkt.reserve(maxP);
+		uint8_t agg = uint8_t(w) << wBitshift;
+		if (zFlag) agg |= uint8_t(zMask);
+		if (yFlag) agg |= uint8_t(yMask);
+		if (nFlag) agg |= uint8_t(nMask);
+		pkt.push_back(byte(agg));
+		for (size_t k = 0; k < elems.size(); ++k) {
+			const Elem &e = elems[k];
+			if (w == 0 || k + 1 < elems.size())
+				writeLeb128(pkt, e.len);
+			pkt.insert(pkt.end(), obus[e.obu].begin() + e.off, obus[e.obu].begin() + e.off + e.len);
+		}
+		packets.push_back(std::move(pkt));
+	}
+	return packets;
+}
