# Web-Root von lumora-streaming.de UND lumora.kara-webdesign.de (gleiches Verzeichnis)

# Verzeichnis-Listing (autoindex) deaktivieren – kein Auflisten von Dateien/Ordnern
Options -Indexes

# ==== Domain-Umzug (2026-07-17): lumora-streaming.de ist primär =====
# Website-Aufrufe der alten Subdomain werden dauerhaft (301) zur neuen Domain
# umgeleitet. AUSGENOMMEN sind alle Pfade, die in installierten Clients fest
# eingebettet sind (Update-Feed, Vermittlung, Domain-Player, Download, Deploy):
# ein Redirect würde deren POST-Aufrufe brechen. Für diese Pfade bleibt die
# alte Domain dauerhaft die stille Brücke – NIEMALS abschalten!
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^lumora\.kara-webdesign\.de$ [NC]
  RewriteCond %{REQUEST_URI} !^/updates/ [NC]
  RewriteCond %{REQUEST_URI} !^/gruppe\.php [NC]
  RewriteCond %{REQUEST_URI} !^/download\.php [NC]
  RewriteCond %{REQUEST_URI} !^/player\.html [NC]
  RewriteCond %{REQUEST_URI} !^/sync- [NC]
  RewriteCond %{REQUEST_URI} !^/lib- [NC]
  RewriteCond %{REQUEST_URI} !^/data/ [NC]
  RewriteRule ^(.*)$ https://lumora-streaming.de/$1 [R=301,L]

  # www-Subdomain lieferte bisher denselben Inhalt OHNE Redirect aus (200 statt 301) -
  # zwei identisch crawlbare URLs fuer dieselbe Seite, nur per canonical-Tag verbunden.
  # Bing (strenger als Google) stufte das als Grund fuer "Issues preventing indexation"
  # ein (Webmaster-Tools-Befund 2026-07-29). www ist in keinem Client fest verdrahtet
  # (Repo-weit geprueft) - daher ohne Pfad-Ausnahmen dauerhaft auf non-www umleiten.
  RewriteCond %{HTTP_HOST} ^www\.lumora-streaming\.de$ [NC]
  RewriteRule ^(.*)$ https://lumora-streaming.de/$1 [R=301,L]

  # Kurze Adresse fuer geteilte Ruckler-Berichte: /b/<id> -> bericht.php?id=<id>
  # Die ID ist bewusst kurz und vorlesbar (6 Zeichen, ohne 0/1/i/l/o) - der Link soll
  # sich in einem Forenbeitrag oder Chat abtippen lassen. Intern KEIN Redirect, sondern
  # stille Weiterleitung: die schoene Adresse bleibt in der Adresszeile stehen.
  RewriteRule ^b/([a-z0-9]{6})/?$ bericht.php?id=$1 [L,QSA]
</IfModule>

# Beim Aufruf des Ordners immer index.html ausliefern
DirectoryIndex index.html

# Kleine Sicherheits-/Hygiene-Header
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
